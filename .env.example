# ============================================
# 环境变量配置模板
# 使用方法：复制为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
# 然后： set -a; source .env; set +a
# ============================================

# Flask
SECRET_KEY=请填写随机字符串
# 跨域白名单，多个用英文逗号分隔
CORS_ORIGINS=http://127.0.0.1,http://localhost
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# MySQL 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写数据库密码
DB_NAME=flask_login_system

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=processed_orders

# Moonshot (Kimi) API
MOONSHOT_API_KEY=请填写你的API密钥
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# ============================================
# Spark Streaming / Sqoop / Flume（命令行提交任务时导出）
# ============================================

# Spark Streaming 的 MySQL JDBC 连接串
MYSQL_JDBC_URL=jdbc:mysql://39.105.42.89:3306/orders7?useSSL=false&serverTimezone=UTC&rewriteBatchedStatements=true
# Spark Streaming 消费的 Kafka 地址
KAFKA_BOOTSTRAP_SERVERS=39.105.42.89:9092

# Sqoop 导入用的 MySQL 连接信息（与上面 DB_* 可共用）
MYSQL_HOST=39.105.42.89

# Flume Agent 启动参数示例（不要写进仓库）：
#   flume-ng agent -n a1 -c conf -f flume/flume.conf \
#     -Dkafka.broker=39.105.42.89:9092 \
#     -Dhdfs.namenode=hdfs://your-namenode:8020
